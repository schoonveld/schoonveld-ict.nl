---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { getResumeData, skills } from "@/lib/resume";

interface Props {
	locale: "nl" | "en";
}

const { locale } = Astro.props;
const { t, introEntry, IntroContent, items, education, certifications } =
	await getResumeData(locale);

const resumePdfHref = locale === "en" ? "/en/resume.pdf" : "/resume.pdf";
---

<Layout
	title="CV — Steffen Schoonveld | Schoonveld ICT"
	description="CV van Steffen Schoonveld, senior full-stack software engineer: 15+ jaar ervaring met Java, Spring, TypeScript en cloud-native development."
	t={t}
	locale={locale}
>
	<!-- Intro -->
	<section class="mx-auto max-w-4xl px-4 pt-16 pb-12 sm:px-6">
		<p class="animate-fade-up text-rose-600 dark:text-rose-400 font-mono text-sm tracking-wider">
			{introEntry.data.eyebrow}
		</p>
		<h1
			class="animate-fade-up mt-4 text-4xl font-bold tracking-tight sm:text-5xl"
			style="animation-delay: 100ms"
		>
			{introEntry.data.title}
		</h1>
		<p
			class="animate-fade-up text-muted-foreground mt-2 font-mono text-lg"
			style="animation-delay: 150ms"
		>
			{introEntry.data.subtitle}
		</p>

		<div
			class="animate-fade-up text-muted-foreground mt-8 space-y-4 text-lg leading-relaxed [&_p]:leading-relaxed [&_h2]:text-foreground [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h3]:text-foreground [&_h3]:text-xl [&_h3]:font-bold [&_h3]:tracking-tight [&_h4]:text-foreground [&_h4]:text-lg [&_h4]:font-bold"
			style="animation-delay: 200ms"
		>
			<IntroContent />
		</div>

		<h2 class="mt-8 text-3xl font-bold tracking-tight">{t.resume.skillsTitle}</h2>

		<div class="animate-fade-up mt-8 flex flex-wrap gap-2" style="animation-delay: 300ms">
			{skills.map((skill) => <Badge variant="outline" class="font-mono text-xs">{skill}</Badge>)}
		</div>

		<div class="animate-fade-up mt-8" style="animation-delay: 400ms">
			<Button href={resumePdfHref} variant="primary" target="_blank" rel="noopener">
				{t.resume.downloadCta}
			</Button>
		</div>
	</section>

	<!-- Work experience timeline -->
	<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
		<div data-reveal>
			<h2 class="mt-3 text-3xl font-bold tracking-tight">{t.resume.workTitle}</h2>
		</div>

		<ol class="border-border relative mt-12 space-y-14 border-s-2 ps-8 sm:ps-10">
			{
				items.map(({ entry, Content }, index) => (
					<li class="relative" data-reveal style={`--reveal-delay: ${Math.min(index, 3) * 100}ms`}>
						<span
							class="border-primary bg-background absolute top-1 -start-8 ms-[-9px] block size-4 rounded-full border-[3px] sm:-start-10"
							aria-hidden="true"
						/>
						<p class="text-rose-600 dark:text-rose-400 font-mono text-sm">
							{entry.data.from} — {entry.data.until}
						</p>
						<h3 class="mt-2 text-xl font-bold tracking-tight sm:text-2xl">
							{entry.data["job-title"]}
						</h3>
						<p class="mt-1 font-mono text-sm">
							@ {entry.data.company}
						</p>
						<div class="text-muted-foreground mt-4 space-y-3 leading-relaxed [&_li]:mt-1.5 [&_strong]:text-foreground [&_ul]:list-disc [&_ul]:ps-5 [&_h3]:text-foreground [&_h3]:text-lg [&_h3]:font-bold [&_h3]:tracking-tight [&_h4]:text-foreground [&_h4]:text-base [&_h4]:font-bold [&_h4]:tracking-tight">
							<Content />
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<!-- Education & certifications -->
	<section class="border-border/60 bg-muted/40 mt-12 border-t">
		<div class="mx-auto grid max-w-4xl gap-12 px-4 py-16 sm:grid-cols-2 sm:px-6">
			<div data-reveal>
				<p class="text-rose-600 dark:text-rose-400 font-mono text-sm tracking-wider">{t.resume.educationEyebrow}</p>
				<h2 class="mt-3 text-2xl font-bold tracking-tight">{t.resume.educationTitle}</h2>
				<ul class="mt-6 space-y-6">
					{
						education.map((item) => (
							<li>
								<p class="font-bold">{item.school}</p>
								<p class="text-muted-foreground mt-1">{item.degree}</p>
								<p class="text-muted-foreground mt-1 font-mono text-sm">{item.year}</p>
							</li>
						))
					}
				</ul>
			</div>
			<div data-reveal style="--reveal-delay: 150ms">
				<p class="text-rose-600 dark:text-rose-400 font-mono text-sm tracking-wider">
					{t.resume.certEyebrow}
				</p>
				<h2 class="mt-3 text-2xl font-bold tracking-tight">{t.resume.certTitle}</h2>
				<ul class="mt-6 space-y-6">
					{
						certifications.map((item) => (
							<li>
								<p class="font-bold">{item.name}</p>
								<p class="text-muted-foreground mt-1">{item.detail}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</Layout>
