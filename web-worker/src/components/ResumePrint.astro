---
import "@/styles/global.css";
import Logo from "@/components/logo.astro";
import { Badge } from "@/components/starwind/badge";
import { getResumeData, skills } from "@/lib/resume";

interface Props {
	locale: "nl" | "en";
}

const { locale } = Astro.props;
const { t, introEntry, IntroContent, items, education, certifications } =
	await getResumeData(locale);

const email = "steffen@schoonveld-ict.nl";
const phone = "06-41361795";
const website = "schoonveld-ict.nl";

const languages =
	locale === "nl"
		? [
				{ name: "Nederlands", level: "moedertaal" },
				{ name: "Engels", level: "vloeiend" },
				{ name: "Duits", level: "basis" },
			]
		: [
				{ name: "Dutch", level: "native speaker" },
				{ name: "English", level: "fluent" },
				{ name: "German", level: "basic" },
			];
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<title>CV — {introEntry.data.title}</title>
		<style>
			@page {
				size: A4;
				margin: 12mm;
			}

			:root {
				color-scheme: light;
			}

			* {
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			.entry {
				break-inside: auto;
			}

			.entry + .entry {
				margin-top: 26px;
			}
		</style>
	</head>
	<body class="bg-background text-foreground font-sans text-[10.5pt] leading-relaxed">
		<div class="grid grid-cols-[170px_1fr] items-start gap-6">
			<!-- <img
				src="/hero-image.jpg"
				alt={introEntry.data.title}
				class="border-border size-[92px] shrink-0 rounded-full border object-cover"
				style="object-position: right center;"
			/> -->
			<div class="col-start-2">
				<div class="mb-4 flex items-center gap-2">
					<Logo class="text-navy-700 size-[28px] shrink-0" />
					<span class="text-xl font-bold tracking-tight">
						Schoonveld <span class="text-primary">ICT</span>
					</span>
				</div>
				<h1 class="text-[34px] leading-[1.1] font-bold tracking-tight">
					{introEntry.data.title}
				</h1>
			</div>
		</div>

		<div class="border-border mt-[22px] grid grid-cols-[170px_1fr] gap-6 border-t pt-[22px]">
			<div class="flex flex-col gap-[20px] font-mono text-[11.5px] leading-[1.45]">
				<p class="text-rose-800 mb-3 font-mono text-[13px] tracking-wider">{t.contact.eyebrow}</p>
				<span class="block">
					<span class="font-bold text-foreground block">{t.contact.emailLabel}</span>{email}
				</span>
				<span class="block">
					<span class="font-bold text-foreground block">{t.contact.phoneLabel}</span>{phone}
				</span>
				<span class="block">
					<span class="font-bold text-foreground block">{t.contact.basedInLabel}</span>{t.contact.location}
				</span>
				<span class="block">
					<span class="font-bold text-foreground block">{t.contact.webLabel}</span>{website}
				</span>
			</div>
			<div>
				<p class="text-rose-800 mb-3 font-mono text-[13px] tracking-wider">
					{t.resume.profileEyebrow}
				</p>
				<div class="text-muted-foreground max-w-[62ch] space-y-2.5 text-[14.5px] leading-[1.6]">
					<IntroContent />
				</div>
			</div>
		</div>

		<div class="ml-[194px] mt-[34px]">
			<p class="text-rose-800 mb-3.5 font-mono text-[13px] tracking-wider">
				{t.resume.skillsEyebrow}
			</p>
			<div class="flex flex-wrap gap-2 font-mono">
				{skills.map((skill) => <Badge variant="outline" class="font-mono text-xs">{skill}</Badge>)}
			</div>
		</div>

		<p class="text-rose-800 mt-9 mb-[18px] ml-[194px] font-mono text-[13px] tracking-wider">
			{t.resume.workEyebrow}
		</p>
		<div class="relative bg-[linear-gradient(to_right,transparent_0,transparent_180px,var(--input)_180px,var(--input)_182px,transparent_182px)]">
			{
				items.map(({ entry, Content }) => (
					<div class="entry relative grid grid-cols-[170px_1fr] gap-6">
						<span
							class="bg-primary absolute top-1 left-[177px] block size-[9px] rounded-full shadow-[0_0_0_3px_var(--background)]"
							aria-hidden="true"
						/>
						<div class="flex flex-col gap-y-3 leading-none">
							<p class="m-0 text-right font-mono text-[12.5px] font-bold">
								<span class="text-muted-foreground font-normal">@</span> {entry.data.company}
							</p>

							<div>
								<p class="m-0 text-muted-foreground font-mono text-[11.5px] text-right">
									{entry.data.from}
								</p>
								<p class="m-0 text-muted-foreground font-mono text-[11.5px] text-right">
									{entry.data.until}
								</p>
							</div>
							
						</div>
						<div>
							<h2 class="text-[16.5px] font-bold tracking-tight">{entry.data["job-title"]}</h2>
							<div class="text-muted-foreground mt-2 max-w-[62ch] space-y-1.5 text-[14px] leading-[1.6] [&_li]:mb-[3px] [&_p:has(>strong:only-child)]:mt-3 [&_p:has(>strong:only-child)]:mb-1.5 [&_p:has(>strong:only-child)]:text-[13px] [&_strong]:text-foreground [&_ul]:list-disc [&_ul]:pl-[18px]">
								<Content />
							</div>
						</div>
					</div>
				))
			}
		</div>

		<p class="text-rose-800 mt-9 mb-[18px] ml-[194px] font-mono text-[13px] tracking-wider">
			{t.resume.educationEyebrow}
		</p>
		{
			education.map((item) => (
				<div class="entry grid grid-cols-[170px_1fr] gap-6">
					<p class="text-muted-foreground justify-self-end font-mono text-[11.5px]">{item.year}</p>
					<div>
						<h2 class="text-[15px] font-bold tracking-tight">{item.degree}</h2>
						<p class="text-muted-foreground mt-1 text-[14px]">{item.school}</p>
					</div>
				</div>
			))
		}

		<p class="text-rose-800 mt-9 mb-3.5 ml-[194px] font-mono text-[13px] tracking-wider">
			{t.resume.certEyebrow}
		</p>
		<ul class="text-muted-foreground ml-[194px] list-disc space-y-[3px] pl-[18px] text-[14px] leading-[1.6]">
			{
				certifications.map((item) => (
					<li>
						<span class="text-foreground font-bold">{item.name}</span> — {item.detail}
					</li>
				))
			}
		</ul>

		<p class="text-rose-800 mt-8 mb-3.5 ml-[194px] font-mono text-[13px] tracking-wider">
			{t.resume.languagesEyebrow}
		</p>
		<div class="ml-[194px] flex flex-wrap gap-x-7 gap-y-2 font-mono text-[12.5px]">
			{
				languages.map((lang) => (
					<span>
						{lang.name} <span class="text-muted-foreground">— {lang.level}</span>
					</span>
				))
			}
		</div>
	</body>
</html>
