---
import "@/styles/global.css";
import Logo from "@/components/logo.astro";
import { getResumeData } from "@/lib/resume";

interface Props {
	locale: "nl" | "en";
}

const { locale } = Astro.props;
const { t, introEntry, IntroContent, items } = await getResumeData(locale);

const education = [
	{
		school: "Hanzehogeschool Groningen",
		degree: "BSc — Informatica & Communicatietechnologie",
		year: "2007",
	},
	{
		school: "Noorderpoort College Groningen",
		degree: "Technische Informatica",
		year: "2004",
	},
];

const certifications = [
	{ name: "Certified Scrum Master", detail: "Certificaat behaald" },
	{ name: "Elasticsearch Engineer", detail: "Certificaat van deelname" },
];

const email = "steffen@schoonveld-ict.nl";
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<title>CV — {introEntry.data.title}</title>
		<style>
			@page {
				size: A4;
				margin: 18mm;
			}

			:root {
				color-scheme: light;
			}

			.print-header {
				min-height: 40mm;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8mm;
				padding-bottom: 6mm;
				border-bottom: 1px solid var(--color-navy-100);
				margin-bottom: 8mm;
			}

			.sidebar {
				position: fixed;
				top: 40mm;
				left: 0;
				width: 55mm;
			}

			.main-col {
				margin-left: 63mm;
				border-left: 1px solid var(--color-navy-100);
				padding-left: 8mm;
			}
		</style>
	</head>
	<body class="bg-background text-foreground font-sans text-[10.5pt] leading-relaxed">
		<header class="print-header">
			<div class="flex items-center gap-2">
				<Logo class="text-navy-700 size-7 shrink-0" />
				<span class="text-base font-bold tracking-tight">
					Schoonveld <span class="text-primary">ICT</span>
				</span>
			</div>
			<div class="flex items-center gap-4">
				<div class="text-right">
					<h1 class="text-2xl font-bold tracking-tight">{introEntry.data.title}</h1>
					<p class="text-muted-foreground font-mono text-sm">{introEntry.data.subtitle}</p>
				</div>
				<div class="border-navy-100 size-[28mm] shrink-0 overflow-hidden rounded-full border">
					<img
						src="/hero-image.jpg"
						alt={introEntry.data.title}
						class="size-full object-cover"
						style="object-position: right center;"
					/>
				</div>
			</div>
		</header>

		<aside class="sidebar space-y-8 text-sm">
			<div>
				<p class="text-muted-foreground text-xs font-bold tracking-wider uppercase">Contact</p>
				<p class="mt-2">{t.contact.emailLabel} {email}</p>
				<p class="mt-1">{t.contact.basedInLabel} {t.contact.location}</p>
			</div>

			<div>
				<p class="text-muted-foreground text-xs font-bold tracking-wider uppercase">
					{t.resume.educationTitle}
				</p>
				<ul class="mt-2 space-y-4">
					{
						education.map((item) => (
							<li class="[break-inside:avoid]">
								<p class="font-bold">{item.school}</p>
								<p class="text-muted-foreground">{item.degree}</p>
								<p class="text-muted-foreground text-xs">{item.year}</p>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<p class="text-muted-foreground text-xs font-bold tracking-wider uppercase">
					{t.resume.certTitle}
				</p>
				<ul class="mt-2 space-y-4">
					{
						certifications.map((item) => (
							<li class="[break-inside:avoid]">
								<p class="font-bold">{item.name}</p>
								<p class="text-muted-foreground">{item.detail}</p>
							</li>
						))
					}
				</ul>
			</div>
		</aside>

		<main class="main-col">
			<div class="text-muted-foreground space-y-3 text-sm [&_p]:leading-relaxed">
				<IntroContent />
			</div>

			<section class="mt-10">
				<h2 class="text-foreground text-lg font-bold tracking-tight">{t.resume.workTitle}</h2>
				<ol class="border-navy-100 relative mt-6 space-y-8 border-l-2 pl-6">
					{
						items.map(({ entry, Content }) => (
							<li class="relative [break-inside:avoid]">
								<span
									class="border-primary bg-background absolute top-1 -left-[29px] block size-3 rounded-full border-2"
									aria-hidden="true"
								/>
								<p class="text-primary font-mono text-xs">
									{entry.data.from} — {entry.data.until}
								</p>
								<h3 class="mt-1 text-base font-bold tracking-tight">{entry.data["job-title"]}</h3>
								<p class="text-muted-foreground mt-0.5 font-mono text-xs">@ {entry.data.company}</p>
								<div class="text-muted-foreground mt-2 space-y-2 text-sm [&_li]:mt-1 [&_strong]:text-foreground [&_ul]:list-disc [&_ul]:pl-5">
									<Content />
								</div>
							</li>
						))
					}
				</ol>
			</section>
		</main>
	</body>
</html>
