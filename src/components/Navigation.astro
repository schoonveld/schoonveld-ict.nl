---
import { Button } from "@/components/starwind/button";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import Logo from "./logo.astro";

const links = [
	{ href: "/", label: "Home" },
	{ href: "/resume", label: "Resume" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
	class="border-border/60 bg-background/80 fixed top-0 z-50 w-full border-b backdrop-blur-md"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
		<a href="/" class="group flex items-center gap-3" aria-label="Schoonveld ICT home">
			<Logo
				class="text-foreground size-9 transition-transform duration-300 group-hover:-rotate-6"
			/>
			<span class="text-lg md:text-2xl font-bold tracking-tight">
				Schoonveld <span class="text-gold-600 dark:text-gold-400">ICT</span>
			</span>
		</a>

		<nav class="flex items-center gap-1 sm:gap-3" aria-label="Main navigation">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={[
							"rounded-md px-3 py-2 font-mono text-sm transition-colors duration-200",
							currentPath === link.href
								? "text-foreground bg-muted"
								: "text-muted-foreground hover:text-foreground hover:bg-muted/60",
						]}
						aria-current={currentPath === link.href ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
			<ThemeToggle transition:persist />
			<Button href="/#contact" variant="primary" size="sm" class="ml-1 hidden sm:inline-flex">
				Get in touch
			</Button>
		</nav>
	</div>
</header>
