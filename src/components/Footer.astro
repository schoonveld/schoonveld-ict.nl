---
const year = new Date().getFullYear();
---

<footer class="border-border/60 border-t">
	<div
		class="text-muted-foreground mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm sm:flex-row sm:px-6"
	>
		<div class="flex items-center gap-3">
			<img src="/logo.svg" alt="" class="size-7" />
			<span>
				© {year} Schoonveld ICT — Freelance software engineering
			</span>
		</div>
		<div class="flex items-center gap-6 font-mono text-xs">
			<a href="/resume" class="hover:text-foreground transition-colors">Resume</a>
			<a href="/#contact" class="hover:text-foreground transition-colors">Contact</a>
			<a href="mailto:steffen@schoonveld-ict.nl" class="hover:text-foreground transition-colors">
				steffen@schoonveld-ict.nl
			</a>
		</div>
	</div>
</footer>
