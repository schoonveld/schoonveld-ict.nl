---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import ContactSection from "@/components/ContactSection.astro";
import { Button } from "@/components/starwind/button";
import { getUiTranslations } from "@/lib/i18n";

const t = await getUiTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? "en";
---

<Layout title="Schoonveld ICT — Freelance Software Engineering" t={t} locale={locale}>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-y-0 right-0 w-full select-none lg:w-[62%]">
			<img
				src="/hero-image.jpg"
				alt="Steffen Schoonveld, freelance software engineer"
				class="h-full w-full object-cover object-right opacity-25 [mask-image:linear-gradient(to_right,transparent_5%,black_60%)] lg:opacity-100"
			/>
		</div>

		<div class="relative mx-auto flex min-h-[calc(100svh-12rem)] max-w-6xl items-center px-4 py-20 sm:px-6">
			<div class="max-w-xl">
				<p
					class="animate-fade-up text-gold-600 dark:text-gold-400 font-mono text-sm tracking-wider"
				>
					{t.hero.eyebrow}
				</p>
				<h1
					class="animate-fade-up mt-5 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
					style="animation-delay: 100ms"
				>
					{t.hero.title}
				</h1>
				<p
					class="animate-fade-up text-muted-foreground mt-6 text-lg leading-relaxed"
					style="animation-delay: 200ms"
				>
					{t.hero.description}
				</p>
				<div class="animate-fade-up mt-10 flex flex-wrap gap-4" style="animation-delay: 300ms">
					<Button href="#contact" variant="primary" size="lg">{t.hero.ctaPrimary}</Button>
					<Button href={getRelativeLocaleUrl(locale, "/resume")} variant="outline" size="lg">{t.hero.ctaSecondary}</Button>
				</div>
			</div>
		</div>
	</section>

	<ContactSection t={{ contact: t.contact, form: t.form }} siteKey={import.meta.env.TURNSTILE_SITE_KEY} apiUrl={import.meta.env.CONTACT_API_URL} />
</Layout>
