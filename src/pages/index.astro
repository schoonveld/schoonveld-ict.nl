---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="mt-30 px-4 grow flex flex-col items-center gap-14 text-center">
    <h1 class="font-audiowide text-5xl text-white">
      <span>Steffen</span>
      <span>Schoonveld</span>
    </h1 >
    <h2 class="font-normal font-bold text-4xl">
      <span class="gradient bg-clip-text text-transparent">Full-Stack</span><br/>
      <span class="gradient bg-clip-text text-transparent">Software Engineer</span>
    </h2>
    <a class="relative cursor-pointer" href="/CV_Steffen_Schoonveld_04-2025.pdf">
      <div class="absolute top-2 left-2 h-full w-full gradient"></div>
      <div class=" relative p-6 bg-white hover:translate-2 hover:translate-y-2">
        <p class="font-audiowide text-1xl text-black">Download Resume</p>
      </div>
    </a>
  </div>
</Layout>
